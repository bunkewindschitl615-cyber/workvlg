---
import Icon from '@/components/ui/Icon.astro';
import PlaceholderNotice from '@/components/ui/PlaceholderNotice.astro';
import Section from '@/components/ui/Section.astro';
import { contactChannels } from '@/config/contacts';
import { site } from '@/config/site';

const legalNotes = contactChannels.flatMap((channel) => (channel.legalNote ? [channel.legalNote] : []));
---

<Section id="kontakty" eyebrow="09 / Контакты" title="Связаться с нами" lead="Выберите удобный способ: позвоните, напишите в мессенджер или подпишитесь на наши страницы в соцсетях.">
  <ul class="contacts">
    {
      contactChannels.map((channel) => (
        <li>
          <a href={channel.href} class="contact" {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            <span class="contact__icon">
              <Icon name={channel.icon} size={24} />
            </span>
            <span class="contact__text">
              <span class="contact__label">{channel.label}</span>
              <span class="contact__value">{channel.display}</span>
            </span>
            <Icon name={channel.external ? 'arrow-up-right' : 'arrow-right'} size={20} class="contact__arrow" />
          </a>
        </li>
      ))
    }
    <li>
      <div class="contact contact--static">
        <span class="contact__icon">
          <Icon name="map-pin" size={24} />
        </span>
        <span class="contact__text">
          <span class="contact__label">География работы</span>
          <span class="contact__value">{site.region.city} и {site.region.area}</span>
        </span>
      </div>
    </li>
  </ul>
  {contactChannels.length === 0 && <PlaceholderNotice subject="блок контактов" class="contacts__notice" />}
  {legalNotes.map((note) => <p class="contacts__legal">* {note}</p>)}
</Section>

<style>
  .contacts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    height: 100%;
    padding: var(--sp-5);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  a.contact:hover {
    border-color: var(--c-accent-line);
    background: var(--c-surface-2);
    color: var(--c-text);
  }

  .contact__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-md);
    background: var(--c-accent-soft);
    color: var(--c-accent);
  }

  .contact__text {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .contact__label {
    color: var(--c-text-subtle);
    font-size: var(--fs-xs);
  }

  .contact__value {
    overflow-wrap: anywhere;
    font-weight: var(--fw-semibold);
  }

  .contact :global(.contact__arrow) {
    color: var(--c-text-subtle);
  }

  .contacts + :global(.contacts__notice) {
    margin-top: var(--sp-6);
  }

  .contacts__legal {
    margin: var(--sp-4) 0 0;
    color: var(--c-text-subtle);
    font-size: var(--fs-xs);
  }
</style>
