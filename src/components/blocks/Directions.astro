---
import Card from '@/components/ui/Card.astro';
import PlaceholderNotice from '@/components/ui/PlaceholderNotice.astro';
import Section from '@/components/ui/Section.astro';
import { leadHref } from '@/config/navigation';
import type { CollectionEntry } from 'astro:content';

interface Props {
  services: CollectionEntry<'services'>[];
}

const { services } = Astro.props;
const hasDrafts = services.some((service) => !service.data.ownerConfirmed);
---

<Section
  id="uslugi"
  eyebrow="01 / Направления"
  title="Чем мы занимаемся"
  lead="От мелкого бытового ремонта до комплексных строительных задач. Выберите направление или просто опишите задачу — мы подскажем, как её решить."
>
  <ul class="directions">
    {
      services.map((service, i) => (
        <li>
          <Card
            icon={service.data.icon}
            index={String(i + 1).padStart(2, '0')}
            title={service.data.title}
            href={leadHref(service.id)}
            moreLabel="Обсудить задачу"
          >
            <p>{service.data.summary}</p>
          </Card>
        </li>
      ))
    }
  </ul>
  {hasDrafts && <PlaceholderNotice kind="draft" subject="перечень и описания направлений" class="directions__notice" />}
</Section>

<style>
  .directions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--sp-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directions :global(.directions__notice) {
    margin-top: var(--sp-6);
  }
</style>
