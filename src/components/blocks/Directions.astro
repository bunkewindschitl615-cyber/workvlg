---
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import PlaceholderNotice from '@/components/ui/PlaceholderNotice.astro';
import Section from '@/components/ui/Section.astro';
import { serviceHref, type Service } from '@/lib/services';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
const hasDrafts = services.some((service) => !service.data.ownerConfirmed);
---

<Section
  id="uslugi"
  eyebrow="01 / Направления"
  title="Чем мы занимаемся"
  lead="От мелкого бытового ремонта до комплексных строительных задач. Выберите направление или просто опишите задачу — мы подскажем, как её решить."
>
  <ul class="directions">
    {
      services.map((service, i) => (
        <li>
          <Card
            icon={service.data.icon}
            index={String(i + 1).padStart(2, '0')}
            title={service.data.title}
            href={serviceHref(service)}
            moreLabel={service.data.hasPage ? 'Подробнее' : 'Обсудить задачу'}
          >
            <p>{service.data.summary}</p>
          </Card>
        </li>
      ))
    }
  </ul>
  <div class="directions__footer">
    <Button href="/uslugi/" variant="secondary" iconEnd="arrow-right">Все услуги</Button>
    {hasDrafts && <PlaceholderNotice kind="draft" subject="перечень и описания направлений" />}
  </div>
</Section>

<style>
  .directions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--sp-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directions__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }
</style>
