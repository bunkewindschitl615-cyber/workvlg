---
import { PUBLIC_GOOGLE_VERIFICATION, PUBLIC_YANDEX_VERIFICATION } from 'astro:env/server';
import { features } from '@/config/features';
import { site } from '@/config/site';

export interface SeoProps {
  /** Page title without the brand suffix. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative image path for Open Graph previews. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description = site.defaultDescription, image, type = 'website', noindex = false } = Astro.props as SeoProps;

const fullTitle = title ? site.titleTemplate(title) : site.defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const robots = !features.indexing || noindex ? 'noindex, nofollow' : 'index, follow';
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

{PUBLIC_YANDEX_VERIFICATION && <meta name="yandex-verification" content={PUBLIC_YANDEX_VERIFICATION} />}
{PUBLIC_GOOGLE_VERIFICATION && <meta name="google-site-verification" content={PUBLIC_GOOGLE_VERIFICATION} />}
