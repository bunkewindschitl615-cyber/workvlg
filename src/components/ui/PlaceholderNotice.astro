---
import Icon from './Icon.astro';

interface Props {
  /** What exactly is a placeholder, e.g. "фотографии", "описание проекта". */
  subject?: string;
  /** demo — material will be replaced; draft — real wording awaiting owner approval. */
  kind?: 'demo' | 'draft';
  class?: string;
}

const { subject = 'материал', kind = 'demo', class: className } = Astro.props;
const message =
  kind === 'draft' ? `Черновик: ${subject} ожидает подтверждения владельца.` : `Демонстрационный ${subject}: будет заменён реальными данными.`;
---

<p class:list={['placeholder', className]} role="note">
  <Icon name="info" size={18} />
  <span>{message}</span>
</p>

<style>
  .placeholder {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 0;
    padding: var(--sp-2) var(--sp-3);
    border: 1px dashed var(--c-warning);
    border-radius: var(--r-sm);
    background: var(--c-warning-soft);
    color: var(--c-warning);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    line-height: 1.4;
  }
</style>
