# Скопируйте этот файл в .env и заполните значения.
# Пустая переменная = функция или канал связи на сайте не отображается.
# Файл .env не попадает в git.

# --- Сайт ---
# Публичный адрес сайта: используется для canonical, sitemap и Open Graph.
SITE_URL=http://localhost:4321
# true — разрешить индексацию поисковиками. Включать только после запуска с реальными данными.
PUBLIC_INDEXING=false

# --- Контакты (реальные данные владельца) ---
# Российский номер в любом формате. Если строку убрать, подставится телефон из astro.config.
PUBLIC_CONTACT_PHONE=+7 991 363-41-42
PUBLIC_CONTACT_EMAIL=
# Полные ссылки вида https://... Если строку убрать, подставится https://t.me/vlgwork
PUBLIC_TELEGRAM_URL=https://t.me/vlgwork
PUBLIC_MAX_URL=
PUBLIC_VK_URL=
PUBLIC_INSTAGRAM_URL=
# Показ Instagram выключен по умолчанию: включать после консультации с юристом (закон 72-ФЗ о рекламе).
PUBLIC_SHOW_INSTAGRAM=false

# --- Подтверждение прав в поисковых системах ---
# Значение атрибута content из мета-тега, который выдаёт Яндекс Вебмастер / Google Search Console.
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GOOGLE_VERIFICATION=

# --- Сервер (production) ---
# Адрес и порт Node-сервера после `npm run build`.
HOST=0.0.0.0
PORT=4321
